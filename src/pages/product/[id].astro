---
import Layout from "../../layouts/Layout.astro";
import defaultProducts from "../../data/products.json";
import { env } from "cloudflare:workers";

// SSR: fetch product from KV at request time
const { id } = Astro.params;

let allProducts: any[] = [];
try {
    const kv = (env as any)?.STORE_KV;
    if (kv) allProducts = (await kv.get("products:all", "json")) || [];
} catch {}

if (!allProducts || allProducts.length === 0) {
    allProducts = defaultProducts as any[];
}

const p = allProducts.find((prod: any) => prod.id === id);

if (!p) {
    return Astro.redirect("/");
}

const isLP = p.isLandingPage && p.isLandingPage.toLowerCase() === "yes";
const fmtPrice = (num: number) =>
    num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ".");

const COUNTRY_MAP: Record<string, string> = {
    CI: "Côte d'Ivoire",
    SN: "Sénégal",
    BF: "Burkina Faso",
    TG: "Togo",
    BJ: "Bénin",
    ML: "Mali",
    GA: "Gabon",
    CM: "Cameroun",
    NE: "Niger",
    CG: "Congo Brazzaville",
    CD: "Congo Kinshasa",
    GN: "Guinée",
    TD: "Chad",
};

const cleanDesc = (p.description || "")
    .replace(/fetchpriority="high"/gi, 'loading="lazy"')
    .replace(/<img(?!([^>]*loading=))/g, '<img loading="lazy" ');

let initialReviews: any[] = [];
try {
    const kv = (env as any)?.STORE_KV;
    if (kv) {
        const allReviews: any[] = (await kv.get("reviews:all", "json")) || [];
        initialReviews = allReviews.filter(
            (r: any) =>
                (r.productId === id || r.productId === p.id || (p.code && r.productId === p.code)) &&
                String(r.status || "").toUpperCase() === "PUBLISHED"
        );
    }
} catch {}

const totalReviewsCount = initialReviews.length > 0 ? initialReviews.length : (parseInt(p.reviews || "0") || 0);
const avgReviewsRating = initialReviews.length > 0
    ? (initialReviews.reduce((sum: number, r: any) => sum + (Number(r.rating) || 5), 0) / initialReviews.length).toFixed(1)
    : "4.9";
---

<Layout
    title={`${p.title} - Astro Shop`}
    description={p.description.replace(/<[^>]*>/g, "").slice(0, 160) + "..."}
    image={p.featuredImage}
    product={p}
>
    <main class={`product-page fade-in ${isLP ? "is-lp" : ""}`}>
        {
            isLP && (
                <div
                    class="prod-desc landing-mode-desc"
                    style="margin-top:0; margin-bottom: 24px;"
                >
                    <div id="d-desc-content" set:html={cleanDesc} />
                </div>
            )
        }

        <div class="product-card">
            {
                !isLP && (
                    <div class="prod-gallery">
                        {(Array.isArray(p.gallery) && p.gallery.length > 0) ||
                        (typeof p.gallery === "string" &&
                            p.gallery.toLowerCase() === "yes") ? (
                            <div id="interactive-gallery">
                                <div class="ig-main">
                                    <button
                                        class="ig-btn ig-prev"
                                        id="prev-ig"
                                        aria-label="Image précédente"
                                    >
                                        <i class="fa fa-chevron-left" />
                                    </button>
                                    <img
                                        src={p.featuredImage}
                                        id="ig-main-img"
                                        alt={p.title}
                                        fetchpriority="high"
                                        loading="eager"
                                    />
                                    <button
                                        class="ig-btn ig-next"
                                        id="next-ig"
                                        aria-label="Image suivante"
                                    >
                                        <i class="fa fa-chevron-right" />
                                    </button>
                                </div>
                                <div class="ig-thumbs" id="ig-thumbs">
                                    {[
                                        p.featuredImage,
                                        ...(Array.isArray(p.gallery)
                                            ? p.gallery
                                            : p.images || []),
                                    ].map((img, i) => (
                                        <div
                                            class={`ig-thumb ${i === 0 ? "active" : ""}`}
                                            data-index={i}
                                        >
                                            <img src={img} loading="lazy" />
                                        </div>
                                    ))}
                                </div>
                            </div>
                        ) : (
                            <img
                                src={p.featuredImage}
                                alt={p.title}
                                fetchpriority="high"
                                loading="eager"
                            />
                        )}
                        <div class="prod-badges">
                            <span class="badge badge-sale">
                                🔥 Offre Spéciale
                            </span>
                        </div>
                    </div>
                )
            }
            <div class="prod-info">
                <h1 class="prod-title">{p.title}</h1>
                <a href="#reviews-section" class="prod-rating" style="text-decoration:none; cursor:pointer;" title="Voir les avis clients">
                    <div class="stars">★★★★★</div>
                    <span class="rating-count" id="header-reviews-count">({totalReviewsCount} avis)</span>
                    <span class="rating-badge"
                        ><i class="fa fa-circle-check"></i> Vendeur Vérifié</span
                    >
                </a>
                <div
                    class="price-row"
                    style="margin-bottom: 10px; align-items: center;"
                >
                    <span
                        class="price-now"
                        id="d-price"
                        style="font-size: 42px; color: var(--red);"
                        >{fmtPrice(p.price)} {p.currency}</span
                    >
                    {
                        p.priceOld && (
                            <span
                                class="price-old"
                                id="d-price-old"
                                style="font-size: 21px; color: var(--gray-500);"
                            >
                                {fmtPrice(p.priceOld)} {p.currency}
                            </span>
                        )
                    }
                    {
                        p.priceOld && (
                            <span
                                class="price-save"
                                id="d-price-save"
                                style="font-size: 13.5px; padding: 5px 12px; background: #fef08a; color: #92400e;"
                            >
                                Économisez {fmtPrice(p.priceOld - p.price)}{" "}
                                {p.currency} (-
                                {Math.round(
                                    ((p.priceOld - p.price) / p.priceOld) * 100,
                                )}
                                %)
                            </span>
                        )
                    }
                </div>
                <p
                    class="price-note"
                    style="margin-bottom: 28px; font-size: 14.5px; color: var(--gray-500);"
                >
                    <span style="font-size: 15px;">💰</span> Paiement à la livraison
                    — Zéro risque
                </p>

                <div class="stock-wrap" style="margin-bottom: 28px;">
                    <div
                        class="stock-lbl"
                        style="font-size: 15px; font-weight: 700; color: var(--gray-800); margin-bottom: 10px;"
                    >
                        <span>Stock disponible</span>
                        <strong id="d-stock-lbl" style="color: var(--red);"
                            >⚠️ Plus que {p.stock} unités !</strong
                        >
                    </div>
                    <div
                        class="stock-track"
                        style="height: 10px; background: var(--gray-200); border-radius: 10px;"
                    >
                        <div
                            class="stock-fill"
                            style="width: 90%; height: 100%; border-radius: 10px; background: var(--orange); background: linear-gradient(90deg, var(--orange), #f97316); animation: none;"
                        >
                        </div>
                    </div>
                </div>

                <ul
                    class="feat-list"
                    style="display: flex; flex-direction: column; gap: 14px; margin-bottom: 24px;"
                >
                    <li
                        class="feat-item"
                        style="font-size: 15.5px; color: var(--gray-700); align-items: center;"
                    >
                        <i
                            class="fa fa-check-circle"
                            style="color: var(--green); font-size: 19px; border-radius: 50%; fill: currentColor;"
                        ></i> Livraison gratuite partout
                    </li>
                    <li
                        class="feat-item"
                        style="font-size: 15.5px; color: var(--gray-700); align-items: center;"
                    >
                        <i
                            class="fa fa-check-circle"
                            style="color: var(--green); font-size: 19px; border-radius: 50%; fill: currentColor;"
                        ></i> Paiement uniquement à la réception
                    </li>
                    <li
                        class="feat-item"
                        style="font-size: 15.5px; color: var(--gray-700); align-items: center;"
                    >
                        <i
                            class="fa fa-check-circle"
                            style="color: var(--green); font-size: 19px; border-radius: 50%; fill: currentColor;"
                        ></i> Retour gratuit sous 7 jours
                    </li>
                    <li
                        class="feat-item"
                        style="font-size: 15.5px; color: var(--gray-700); align-items: center;"
                    >
                        <i
                            class="fa fa-check-circle"
                            style="color: var(--green); font-size: 19px; border-radius: 50%; fill: currentColor;"
                        ></i> Service client 7j/7
                    </li>
                </ul>
            </div>
        </div>

        <div class="order-col" id="orderFormBlock">
            <div class="order-card">
                <div class="order-hdr">
                    <div>
                        <h2><i class="fa fa-shield-halved"></i> Passer Ma Commande</h2>
                        <p>Paiement cash à la livraison · Satisfait ou remboursé</p>
                    </div>
                    <div class="order-hdr-badge"><i class="fa fa-lock"></i> 100% Sécurisé</div>
                </div>
                <div class="checkout-steps">
                    <div class="step-item active">
                        <span class="step-num">1</span>
                        <span>Coordonnées</span>
                    </div>
                    <div class="step-item active">
                        <span class="step-num">2</span>
                        <span>Livraison Cash</span>
                    </div>
                </div>
                <div class="order-body">
                    <div class="commit-msg">
                        <i class="fa fa-truck-fast"></i> Livraison gratuite & Paiement à la réception !
                    </div>

                    <form id="orderForm">
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label" for="pays">🌍 Pays <span class="req">*</span></label>
                                <select class="form-control" id="pays" required>
                                    <option value="">Choisir votre pays</option>
                                    {
                                        p.pays
                                            .split(",")
                                            .map((c: string) => (
                                                <option value={c}>
                                                    {COUNTRY_MAP[
                                                        c as keyof typeof COUNTRY_MAP
                                                    ] || c}
                                                </option>
                                            ))
                                    }
                                </select>
                            </div>
                            <div class="form-group">
                                <label class="form-label" for="tel">📱 Téléphone <span class="req">*</span></label>
                                <input
                                    type="tel"
                                    class="form-control"
                                    id="tel"
                                    placeholder="Numéro de téléphone"
                                    required
                                />
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label" for="nom">👤 Nom Complet <span class="req">*</span></label>
                                <input
                                    type="text"
                                    class="form-control"
                                    id="nom"
                                    placeholder="Votre Nom & Prénom"
                                    required
                                />
                            </div>
                            <div class="form-group">
                                <label class="form-label" for="adr">📍 Ville / Quartier <span class="req">*</span></label>
                                <input
                                    type="text"
                                    class="form-control"
                                    id="adr"
                                    placeholder="Ex: Abidjan, Cocody"
                                    required
                                />
                            </div>
                        </div>

                        <div class="form-row">
                            {
                                p.couleur && (
                                    <div class="form-group">
                                        <label class="form-label" for="var-couleur">
                                            <i class="fa fa-palette" /> Couleur
                                        </label>
                                        <select class="form-control" id="var-couleur">
                                            {p.couleur
                                                .split(",")
                                                .map((c: string) => (
                                                    <option value={c}>
                                                        {c}
                                                    </option>
                                                ))}
                                        </select>
                                    </div>
                                )
                            }

                            {
                                p.taille && (
                                    <div class="form-group">
                                        <label class="form-label" for="var-taille">
                                            <i class="fa fa-ruler-combined" /> Taille
                                        </label>
                                        <select class="form-control" id="var-taille">
                                            {p.taille
                                                .split(",")
                                                .map((s: string) => (
                                                    <option value={s}>
                                                        {s}
                                                    </option>
                                                ))}
                                        </select>
                                    </div>
                                )
                            }
                        </div>

                        {
                            p.offres && p.offres.length > 0 && (
                                <div class="offers-selector-wrap">
                                    <span class="offers-title">🎁 Sélectionner Une Offre Spéciale</span>
                                    <div class="offers-list">
                                        {p.offres.map(
                                            (off: any, idx: number) => {
                                                const pct = off.oldPrice
                                                    ? Math.round(
                                                          ((off.oldPrice - off.price) / off.oldPrice) * 100
                                                      )
                                                    : 0;
                                                return (
                                                    <label class={`offer-option-card ${idx === 0 ? "active" : ""}`}>
                                                        <div style="display: flex; align-items: center; gap: 12px; flex: 1;">
                                                            <input
                                                                type="radio"
                                                                name="selected_offer"
                                                                value={idx}
                                                                checked={idx === 0}
                                                                class="offer-radio"
                                                            />
                                                            <div style="display: flex; flex-direction: column; gap: 4px;">
                                                                <span class="offer-option-title">{off.title}</span>
                                                                <span class="offer-option-qty">📦 Quantité: x{off.qty}</span>
                                                            </div>
                                                        </div>
                                                        <div style="text-align: right; display: flex; flex-direction: column; align-items: flex-end; gap: 2px;">
                                                            <span class="offer-option-price">
                                                                {fmtPrice(off.price)} {p.currency}
                                                            </span>
                                                            {off.oldPrice && (
                                                                <div style="display: flex; align-items: center; gap: 6px;">
                                                                    <span class="offer-option-oldprice">
                                                                        {fmtPrice(off.oldPrice)} {p.currency}
                                                                    </span>
                                                                    <span class="offer-option-badge">-{pct}%</span>
                                                                </div>
                                                            )}
                                                        </div>
                                                    </label>
                                                );
                                            },
                                        )}
                                    </div>
                                </div>
                            )
                        }

                        {
                            p.showQuantity === "yes" &&
                                p.bundle !== "yes" &&
                                (!p.offres || p.offres.length === 0) && (
                                    <div class="qty-action-wrap">
                                        <label class="qty-action-lbl" for="manual-qty">Quantité</label>
                                        <div class="qty-box">
                                            <button
                                                type="button"
                                                class="qty-btn"
                                                id="btn-qty-minus"
                                                aria-label="Diminuer la quantité"
                                            >-</button>
                                            <input
                                                type="number"
                                                class="qty-val"
                                                id="manual-qty"
                                                value="1"
                                                readonly
                                            />
                                            <button
                                                type="button"
                                                class="qty-btn"
                                                id="btn-qty-plus"
                                                aria-label="Augmenter la quantité"
                                            >+</button>
                                        </div>
                                    </div>
                                )
                        }

                        <div class="order-summary">
                            <div class="sum-row">
                                <span>Article</span>
                                <span id="sum-price">{fmtPrice(p.price)} {p.currency}</span>
                            </div>
                            <div class="sum-row">
                                <span>Quantité</span>
                                <span id="sum-qty">1</span>
                            </div>
                            <div class="sum-row">
                                <span>Frais de livraison</span>
                                <span style="color: var(--green); font-weight: 800;"><i class="fa fa-check-circle"></i> Gratuit</span>
                            </div>
                            <div class="sum-total">
                                <span>Total à payer:</span>
                                <span id="sum-total">{fmtPrice(p.price)} {p.currency}</span>
                            </div>
                        </div>

                        <button type="submit" class="submit-btn" id="submitBtn">
                            <i class="fa fa-bag-shopping"></i> Valider Ma Commande
                        </button>

                        <div class="trust-seals">
                            <div class="seal-item">
                                <i class="fa fa-truck-fast"></i>
                                <span>Livraison Rapide</span>
                            </div>
                            <div class="seal-item">
                                <i class="fa fa-hand-holding-dollar"></i>
                                <span>Payer À La Livraison</span>
                            </div>
                            <div class="seal-item">
                                <i class="fa fa-rotate-left"></i>
                                <span>7 Jours Satisfait</span>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        {
            !isLP && (
                <div class="prod-desc">
                    <h2 class="section-ttl">
                        <i class="fa fa-file-lines" /> Description
                    </h2>
                    <div id="d-desc-content" set:html={cleanDesc} />
                </div>
            )
        }

        {/* Customer Reviews Section */}
        <section class="prod-reviews-section" id="reviews-section">
            <div class="reviews-container">
                <div class="reviews-header">
                    <div>
                        <h2 class="reviews-section-title">
                            <i class="fa-solid fa-comments" style="color: var(--blue, #2563eb); margin-right: 10px;"></i> Avis Clients Vérifiés
                        </h2>
                        <p class="reviews-section-sub">
                            Témoignages et retours authentiques de clients ayant reçu leur commande.
                        </p>
                    </div>
                    <button class="btn-write-review" id="openReviewModalBtn" type="button">
                        <i class="fa-solid fa-pen-to-square"></i> Donner mon avis
                    </button>
                </div>

                <!-- Rating Summary Box -->
                <div class="reviews-summary-card">
                    <div class="summary-score-col">
                        <div class="score-number" id="store-rating-score">{avgReviewsRating}</div>
                        <div class="stars-gold" style="font-size: 20px; color: #f59e0b; margin: 4px 0;">
                            ★★★★★
                        </div>
                        <div class="score-total">
                            <span id="summary-reviews-count">{totalReviewsCount}</span> avis enregistrés
                        </div>
                        <div class="verified-store-tag">
                            <i class="fa-solid fa-shield-check"></i> 100% Avis Authentiques
                        </div>
                    </div>
                    <div class="summary-details-col" style="flex: 1; min-width: 240px;">
                        <div style="font-weight: 700; font-size: 15px; margin-bottom: 6px; color: var(--gray-900);">
                            Satisfaction Garantie à la Livraison
                        </div>
                        <p style="font-size: 13.5px; color: var(--gray-600); line-height: 1.5; margin: 0 0 12px 0;">
                            Tous nos avis sont vérifiés par notre service client. Vous payez en espèces à la livraison après inspection de votre colis.
                        </p>
                        <div style="display: flex; gap: 16px; flex-wrap: wrap;">
                            <span style="font-size: 12.5px; font-weight: 700; color: var(--green); display: flex; align-items: center; gap: 5px;">
                                <i class="fa-solid fa-truck-fast"></i> Livraison Gratuite
                            </span>
                            <span style="font-size: 12.5px; font-weight: 700; color: var(--blue, #2563eb); display: flex; align-items: center; gap: 5px;">
                                <i class="fa-solid fa-rotate-left"></i> 7 Jours Satisfait ou Remboursé
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Reviews Grid -->
                <div class="reviews-list-grid" id="reviews-list-grid">
                    {initialReviews.map((r: any) => (
                        <div class="review-item-card">
                            <div class="review-item-header">
                                <div class="reviewer-avatar">
                                    {r.author ? r.author.trim().charAt(0).toUpperCase() : 'C'}
                                </div>
                                <div style="flex: 1;">
                                    <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                                        <strong style="font-size: 14.5px; color: var(--gray-900);">{r.author}</strong>
                                        {r.verified !== false && (
                                            <span class="badge-achat-verifie">
                                                <i class="fa-solid fa-circle-check"></i> Achat Vérifié
                                            </span>
                                        )}
                                    </div>
                                    <div style="font-size: 12px; color: var(--gray-500); margin-top: 2px;">
                                        <i class="fa-solid fa-location-dot"></i> {COUNTRY_MAP[r.country] || r.country || ''}{r.city ? ` · ${r.city}` : ''}
                                    </div>
                                </div>
                                <div style="font-size: 11.5px; color: var(--gray-400); white-space: nowrap;">
                                    {r.createdAt ? new Date(r.createdAt).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' }) : ''}
                                </div>
                            </div>
                            <div class="review-item-stars" style="color: #f59e0b; font-size: 14px; margin: 10px 0 6px 0;">
                                {"★".repeat(Math.round(Number(r.rating) || 5))}
                                {"☆".repeat(5 - Math.round(Number(r.rating) || 5))}
                            </div>
                            {r.title && <h4 style="font-size: 14px; font-weight: 700; color: var(--gray-900); margin: 0 0 6px 0;">{r.title}</h4>}
                            <p style="font-size: 13.5px; color: var(--gray-700); line-height: 1.55; margin: 0;">{r.content}</p>
                        </div>
                    ))}
                </div>

                <!-- Empty State (if no published reviews yet) -->
                <div id="reviews-empty-box" style={initialReviews.length === 0 ? "display: block;" : "display: none;"} class="reviews-empty-state">
                    <div style="font-size: 32px; color: #f59e0b; margin-bottom: 8px;"><i class="fa-regular fa-star"></i></div>
                    <h3 style="font-size: 16px; font-weight: 700; color: var(--gray-900); margin-bottom: 4px;">Soyez le premier à donner votre avis !</h3>
                    <p style="font-size: 13px; color: var(--gray-600); margin-bottom: 14px;">Vous avez commandé cet article ? Partagez votre expérience avec nos clients.</p>
                    <button class="btn-write-review" id="emptyWriteReviewBtn" type="button" style="font-size: 13px; padding: 8px 16px;">
                        <i class="fa-solid fa-pen-to-square"></i> Écrire le premier avis
                    </button>
                </div>
            </div>
        </section>
    </main>

    <div class="modal" id="modal-confirm">
        <div class="modal-bg"></div>
        <div class="modal-box">
            <div class="modal-ico green"><i class="fa fa-question"></i></div>
            <h3 class="modal-ttl">Confirmer la commande ?</h3>
            <p class="modal-body">
                Vous êtes sur le point de valider votre commande. Vous paierez
                uniquement à la livraison.
            </p>
            <div class="modal-btns">
                <button class="modal-btn mbtn-cancel" id="m-cancel"
                    >Annuler</button
                >
                <button class="modal-btn mbtn-confirm" id="m-ok"
                    >Oui, Confirmer</button
                >
            </div>
        </div>
    </div>

    <!-- Storefront Customer Review Submission Modal -->
    <div class="review-modal-overlay" id="customerReviewModal">
        <div class="review-modal-box">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px;">
                <h3 style="margin: 0; font-size: 18px; font-weight: 800; color: var(--gray-900); display: flex; align-items: center; gap: 8px;">
                    <i class="fa-solid fa-star" style="color: #f59e0b;"></i> Donner votre avis
                </h3>
                <button type="button" id="closeCustRevModal" style="background: none; border: none; font-size: 24px; cursor: pointer; color: var(--gray-400);">&times;</button>
            </div>
            <form id="storefrontReviewForm">
                <div style="margin-bottom: 14px;">
                    <label style="display: block; font-size: 12.5px; font-weight: 700; margin-bottom: 5px; color: var(--gray-900);">Votre Nom Complet *</label>
                    <input type="text" id="sr-author" class="form-control" required placeholder="Ex: Jean Kouassi" style="width: 100%; border-radius: 10px; padding: 10px 14px;" />
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 14px;">
                    <div>
                        <label style="display: block; font-size: 12.5px; font-weight: 700; margin-bottom: 5px; color: var(--gray-900);">Ville / Commune *</label>
                        <input type="text" id="sr-city" class="form-control" required placeholder="Ex: Abidjan" style="width: 100%; border-radius: 10px; padding: 10px 14px;" />
                    </div>
                    <div>
                        <label style="display: block; font-size: 12.5px; font-weight: 700; margin-bottom: 5px; color: var(--gray-900);">Pays *</label>
                        <select id="sr-country" class="form-control" style="width: 100%; border-radius: 10px; padding: 10px 14px;">
                            {Object.entries(COUNTRY_MAP).map(([code, name]) => (
                                <option value={code}>{name}</option>
                            ))}
                        </select>
                    </div>
                </div>
                <div style="margin-bottom: 14px;">
                    <label style="display: block; font-size: 12.5px; font-weight: 700; margin-bottom: 5px; color: var(--gray-900);">Votre Note *</label>
                    <div id="sr-star-picker" style="display: flex; gap: 6px; font-size: 26px; color: #f59e0b; cursor: pointer; user-select: none;">
                        <span data-star="1">★</span>
                        <span data-star="2">★</span>
                        <span data-star="3">★</span>
                        <span data-star="4">★</span>
                        <span data-star="5">★</span>
                    </div>
                    <input type="hidden" id="sr-rating" value="5" />
                </div>
                <div style="margin-bottom: 14px;">
                    <label style="display: block; font-size: 12.5px; font-weight: 700; margin-bottom: 5px; color: var(--gray-900);">Titre de votre avis</label>
                    <input type="text" id="sr-title" class="form-control" placeholder="Ex: Très bon produit, conforme" style="width: 100%; border-radius: 10px; padding: 10px 14px;" />
                </div>
                <div style="margin-bottom: 18px;">
                    <label style="display: block; font-size: 12.5px; font-weight: 700; margin-bottom: 5px; color: var(--gray-900);">Votre Commentaire *</label>
                    <textarea id="sr-content" class="form-control" rows="3" required placeholder="Expliquez ce qui vous a plu..." style="width: 100%; border-radius: 10px; padding: 10px 14px; resize: vertical;"></textarea>
                </div>
                <div style="display: flex; justify-content: flex-end; gap: 10px;">
                    <button type="button" id="cancelCustRevBtn" class="btn btn-ghost" style="padding: 10px 16px; border-radius: 10px; cursor: pointer;">Annuler</button>
                    <button type="submit" id="submitCustRevBtn" class="btn-write-review" style="padding: 10px 20px;">Publier mon avis</button>
                </div>
            </form>
        </div>
    </div>

    <div class="sticky-bar">
        <a class="sticky-order" href="#orderFormBlock"
            ><i class="fa fa-bag-shopping"></i> Commander</a
        >
        <a
            aria-label="WhatsApp"
            class="sticky-wa"
            href={`https://wa.me/${p.whatsapp.replace(/\+/g, "")}?text=${encodeURIComponent(`Bonjour, je souhaite commander : ${p.title}\nproduct link : https://linanightwear.com/product/${p.id}`)}`}
            target="_blank"><i class="fab fa-whatsapp"></i></a
        >
    </div>
</Layout>

<script is:inline define:vars={{ productData: p }}>
    window.productData = productData;
</script>
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const p = window.productData;
        let qty = 1;
        let price = p.price;
        let selectedOffer = null;

        if (p.offres && p.offres.length > 0) {
            selectedOffer = p.offres[0];
            qty = selectedOffer.qty;
            price = selectedOffer.price;
        }

        if (p.isLandingPage === "yes" || p.modeBlack === "yes") {
            if (p.isLandingPage === "yes")
                document.body.classList.add("lp-mode-active", "is-merci-page");
            if (p.modeBlack === "yes") document.body.classList.add("mode-nuit");
        }

        const fmtPrice = (num) =>
            num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ".");

        const qtyMinus = document.getElementById("btn-qty-minus");
        const qtyPlus = document.getElementById("btn-qty-plus");
        const qtyVal = document.getElementById("manual-qty");
        const sumQty = document.getElementById("sum-qty");
        const sumTotal = document.getElementById("sum-total");

        const updateTotal = () => {
            let totalAmount = price * qty;
            let displayPrice = price;
            if (selectedOffer) {
                totalAmount = selectedOffer.price;
                displayPrice = selectedOffer.price;
            }
            if (sumQty) sumQty.innerText = qty.toString();
            if (sumTotal)
                sumTotal.innerText = fmtPrice(totalAmount) + " " + p.currency;

            const sumPriceEl = document.getElementById("sum-price");
            if (sumPriceEl) {
                sumPriceEl.innerText =
                    fmtPrice(selectedOffer ? selectedOffer.price : price) +
                    " " +
                    p.currency;
            }

            // Update main product card price displays
            const mainPriceEl = document.getElementById("d-price");
            const mainPriceOldEl = document.getElementById("d-price-old");
            const mainPriceSaveEl = document.getElementById("d-price-save");
            if (mainPriceEl) {
                mainPriceEl.innerText =
                    fmtPrice(displayPrice) + " " + p.currency;
            }
            if (selectedOffer) {
                if (mainPriceOldEl) {
                    if (selectedOffer.oldPrice) {
                        mainPriceOldEl.style.display = "inline";
                        mainPriceOldEl.innerText =
                            fmtPrice(selectedOffer.oldPrice) + " " + p.currency;
                    } else {
                        mainPriceOldEl.style.display = "none";
                    }
                }
                if (mainPriceSaveEl) {
                    if (selectedOffer.oldPrice) {
                        mainPriceSaveEl.style.display = "inline";
                        mainPriceSaveEl.innerText =
                            "Économisez " +
                            fmtPrice(
                                selectedOffer.oldPrice - selectedOffer.price,
                            ) +
                            " " +
                            p.currency +
                            " (-" +
                            Math.round(
                                ((selectedOffer.oldPrice -
                                    selectedOffer.price) /
                                    selectedOffer.oldPrice) *
                                    100,
                            ) +
                            "%)";
                    } else {
                        mainPriceSaveEl.style.display = "none";
                    }
                }
            }
        };

        // Initialize display total
        updateTotal();

        // Listen for offer selector radio changes
        const offerRadios = document.querySelectorAll(".offer-radio");
        offerRadios.forEach((radio) => {
            radio.addEventListener("change", (e) => {
                const idx = parseInt(e.target.value);
                selectedOffer = p.offres[idx];
                qty = selectedOffer.qty;
                price = selectedOffer.price;

                // Update active option card styles
                document
                    .querySelectorAll(".offer-option-card")
                    .forEach((card, cIdx) => {
                        const r = card.querySelector(".offer-radio");
                        if (cIdx === idx) {
                            if (r) r.checked = true;
                            card.classList.add("active");
                        } else {
                            if (r) r.checked = false;
                            card.classList.remove("active");
                        }
                    });

                updateTotal();
            });
        });

        if (qtyMinus && qtyPlus && qtyVal) {
            qtyMinus.addEventListener("click", () => {
                if (qty > 1) {
                    qty--;
                    qtyVal.value = qty.toString();
                    updateTotal();
                }
            });
            qtyPlus.addEventListener("click", () => {
                qty++;
                qtyVal.value = qty.toString();
                updateTotal();
            });
        }

        const igThumbs = document.querySelectorAll(".ig-thumb");
        const igMainImg = document.getElementById("ig-main-img");
        let igIndex = 0;

        if (igThumbs.length > 0 && igMainImg) {
            igThumbs.forEach((t, i) => {
                t.addEventListener("click", () => {
                    igThumbs.forEach((x) => x.classList.remove("active"));
                    t.classList.add("active");
                    igMainImg.src = t.querySelector("img").src;
                    igIndex = i;
                });
            });
            document
                .getElementById("prev-ig")
                ?.addEventListener("click", () => {
                    igIndex = (igIndex - 1 + igThumbs.length) % igThumbs.length;
                    igThumbs[igIndex].click();
                });
            document
                .getElementById("next-ig")
                ?.addEventListener("click", () => {
                    igIndex = (igIndex + 1) % igThumbs.length;
                    igThumbs[igIndex].click();
                });
        }

        const GOOGLE_SHEETS_WEBAPP_URL =
            "https://script.google.com/macros/s/AKfycbys57Cg6UpfnbGIwYmxBWXKaww_jvfZWtzYAjAvbXHP2qonMvwz_1tWAXKAEhGfJafy7g/exec";
        const cartSessionId =
            "ASTRO-" +
            Date.now().toString().slice(-6) +
            "-" +
            Math.floor(Math.random() * 10000);
        let isSubmitting = false;
        let lastAbandonedStr = "";

        const getUTMParams = () => {
            const urlParams = new URLSearchParams(window.location.search);
            return {
                utm_source: sessionStorage.getItem("utm_source") || urlParams.get("utm_source") || urlParams.get("source") || "",
                utm_medium: sessionStorage.getItem("utm_medium") || urlParams.get("utm_medium") || urlParams.get("medium") || "",
                utm_campaign: sessionStorage.getItem("utm_campaign") || urlParams.get("utm_campaign") || urlParams.get("campaign") || urlParams.get("campaign_name") || "",
                utm_term: sessionStorage.getItem("utm_term") || urlParams.get("utm_term") || urlParams.get("adset") || "",
                utm_content: sessionStorage.getItem("utm_content") || urlParams.get("utm_content") || urlParams.get("ad") || urlParams.get("ad_name") || urlParams.get("ad_id") || urlParams.get("creative") || "",
            };
        };

        const firePixel = (event, data) => {
            if (typeof fbq === "function") fbq("track", event, data);
        };

        const form = document.getElementById("orderForm");
        if (form) {
            form.addEventListener("submit", async (e) => {
                e.preventDefault();

                let totalAmount = price * qty;
                let productName = p.title;
                if (selectedOffer) {
                    totalAmount = selectedOffer.price;
                    productName = `${p.title} (${selectedOffer.title})`;
                }

                firePixel("InitiateCheckout", {
                    value: totalAmount,
                    currency: p.currency === "CFA" ? "XOF" : p.currency,
                    content_name: productName,
                });

                const ok = await new Promise((res) => {
                    const modal = document.getElementById("modal-confirm");
                    modal.classList.add("open");
                    document.getElementById("m-ok").onclick = () => {
                        modal.classList.remove("open");
                        res(true);
                    };
                    document.getElementById("m-cancel").onclick = () => {
                        modal.classList.remove("open");
                        res(false);
                    };
                });
                if (!ok) return;

                isSubmitting = true;
                const btn = document.getElementById("submitBtn");
                btn.disabled = true;
                btn.innerHTML = 'Envoi... <span class="spinner"></span>';

                const formData = new FormData();
                formData.append("nom", document.getElementById("nom").value);
                formData.append(
                    "telephone",
                    document.getElementById("tel").value,
                );
                formData.append("pays", document.getElementById("pays").value);
                formData.append(
                    "adresse",
                    document.getElementById("adr").value,
                );
                formData.append("produit", productName);
                formData.append("prix", totalAmount + " " + p.currency);
                formData.append("quantity", qty);
                formData.append("platform", "AstroJS");
                formData.append("order_id", cartSessionId);
                formData.append("code", p.code || "");
                formData.append("status", "COMPLETED");

                const vCouleur = document.getElementById("var-couleur");
                const vTaille = document.getElementById("var-taille");
                if (vCouleur) formData.append("couleur", vCouleur.value);
                if (vTaille) formData.append("taille", vTaille.value);

                const utms = getUTMParams();
                try {
                    // 1) Write to Google Sheets (fire-and-forget with keepalive to outlive navigation)
                    fetch(GOOGLE_SHEETS_WEBAPP_URL, {
                        method: "POST",
                        body: formData,
                        mode: "no-cors",
                        keepalive: true,
                    }).catch(() => {});

                    // 2) Dual-write to Cloudflare KV via our API (fire-and-forget with keepalive)
                    const kvPayload = {
                        order_id: cartSessionId,
                        nom: document.getElementById("nom").value,
                        telephone: document.getElementById("tel").value,
                        pays: document.getElementById("pays").value,
                        adresse: document.getElementById("adr").value,
                        produit: productName,
                        prix: totalAmount + " " + (document.getElementById("pays").value === "GN" ? "GNF" : p.currency),
                        currency: (document.getElementById("pays").value === "GN" || p.currency === "GNF") ? "GNF" : (p.currency || "CFA"),
                        quantity: qty,
                        total: totalAmount,
                        code: p.code || "",
                        status: "COMPLETED",
                        ...getUTMParams(),
                        date: new Date().toISOString(),
                    };
                    fetch("/api/orders", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify(kvPayload),
                        keepalive: true,
                    }).catch(() => {});

                    firePixel("Purchase", {
                        value: totalAmount,
                        currency: p.currency === "CFA" ? "XOF" : p.currency,
                        content_name: productName,
                        content_ids: [p.code || window.location.pathname],
                        content_type: "product",
                        num_items: qty,
                    });
                    sessionStorage.setItem(
                        "last_order",
                        JSON.stringify({
                            customer_name: document.getElementById("nom").value,
                            product_name: productName,
                            quantity: qty,
                            total: totalAmount,
                        }),
                    );
                    window.location.href = "/merci";
                } catch (err) {
                    btn.innerHTML = "❌ ÉCHEC, RÉESSAYER";
                    btn.style.background = "#c81e1e";
                    btn.disabled = false;
                    isSubmitting = false;
                }
            });

            // Abandoned Checkout tracking
            const logAbandoned = () => {
                if (isSubmitting) return;
                const requireds = Array.from(
                    form.querySelectorAll("[required]"),
                );
                const allValid = requireds.every((el) => {
                    if (el.type === "checkbox") return el.checked;
                    return (
                        el.value &&
                        el.value.trim().length >= (el.type === "tel" ? 8 : 2)
                    );
                });

                if (allValid) {
                    const tel = document.getElementById("tel").value;
                    const nom = document.getElementById("nom").value;
                    const adr = document.getElementById("adr").value;
                    const pays = document.getElementById("pays").value;

                    const currentStr = tel + nom + adr + pays;
                    if (currentStr === lastAbandonedStr) return;
                    lastAbandonedStr = currentStr;

                    let totalAmount = price * qty;
                    let productName = p.title;
                    if (selectedOffer) {
                        totalAmount = selectedOffer.price;
                        productName = `${p.title} (${selectedOffer.title})`;
                    }

                    const formData = new FormData();
                    formData.append("nom", nom);
                    formData.append("telephone", tel);
                    formData.append("pays", pays);
                    formData.append("adresse", adr);
                    formData.append("produit", productName);
                    formData.append("prix", totalAmount + " " + p.currency);
                    formData.append("quantity", qty);
                    formData.append("status", "ABANDONED");
                    formData.append("code", p.code || "");
                    formData.append("order_id", cartSessionId);
                    fetch(GOOGLE_SHEETS_WEBAPP_URL, {
                        method: "POST",
                        body: formData,
                        mode: "no-cors",
                    }).catch(() => {});

                    // Dual-write to Cloudflare KV API for Admin Panel display
                    const kvPayload = {
                        order_id: cartSessionId,
                        nom: nom,
                        telephone: tel,
                        pays: pays,
                        adresse: adr,
                        produit: productName,
                        prix: totalAmount + " " + (pays === "GN" ? "GNF" : p.currency),
                        currency: (pays === "GN" || p.currency === "GNF") ? "GNF" : (p.currency || "CFA"),
                        quantity: qty,
                        total: totalAmount,
                        code: p.code || "",
                        status: "ABANDONED",
                        ...getUTMParams(),
                        date: new Date().toISOString(),
                    };
                    fetch("/api/orders", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify(kvPayload),
                        keepalive: true,
                    }).catch(() => {});
                }
            };

            form.querySelectorAll("input, select").forEach((el) => {
                el.addEventListener("blur", logAbandoned);
                el.addEventListener("change", logAbandoned);
            });
        }

        // ── Reviews Live Hydration & Customer Submission ──
        const loadReviews = async () => {
            try {
                const prodId = String(p.id || "").toLowerCase();
                const prodCode = String(p.code || "").toLowerCase();
                const pathSlug = window.location.pathname.split("/").filter(Boolean).pop().toLowerCase();
                const res = await fetch("/api/reviews");
                if (!res.ok) return;
                const all = await res.json();
                if (!Array.isArray(all)) return;

                const pub = all.filter((r) => {
                    const rPid = String(r.productId || "").toLowerCase();
                    const matchesId = rPid === prodId || rPid === pathSlug || (prodCode && rPid === prodCode);
                    return matchesId && String(r.status || "").toUpperCase() === "PUBLISHED";
                });

                const grid = document.getElementById("reviews-list-grid");
                const emptyBox = document.getElementById("reviews-empty-box");
                const hdrCount = document.getElementById("header-reviews-count");
                const sumCount = document.getElementById("summary-reviews-count");
                const storeRating = document.getElementById("store-rating-score");

                if (pub.length > 0) {
                    if (emptyBox) emptyBox.style.display = "none";
                    if (hdrCount) hdrCount.textContent = `(${pub.length} avis)`;
                    if (sumCount) sumCount.textContent = pub.length;
                    const avg = (pub.reduce((s, x) => s + (Number(x.rating) || 5), 0) / pub.length).toFixed(1);
                    if (storeRating) storeRating.textContent = avg;

                    if (grid) {
                        grid.innerHTML = pub.map((r) => {
                            const initial = r.author ? r.author.trim().charAt(0).toUpperCase() : "C";
                            const ratingNum = Math.round(Number(r.rating) || 5);
                            const stars = "★".repeat(ratingNum) + "☆".repeat(5 - ratingNum);
                            const dateStr = r.createdAt ? new Date(r.createdAt).toLocaleDateString("fr-FR", { day: "2-digit", month: "short", year: "numeric" }) : "";
                            return `
                                <div class="review-item-card">
                                    <div class="review-item-header">
                                        <div class="reviewer-avatar">${initial}</div>
                                        <div style="flex: 1;">
                                            <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                                                <strong style="font-size: 14.5px; color: var(--gray-900);">${r.author}</strong>
                                                ${r.verified !== false ? `
                                                    <span class="badge-achat-verifie">
                                                        <i class="fa-solid fa-circle-check"></i> Achat Vérifié
                                                    </span>
                                                ` : ""}
                                            </div>
                                            <div style="font-size: 12px; color: var(--gray-500); margin-top: 2px;">
                                                <i class="fa-solid fa-location-dot"></i> ${r.country || ""}${r.city ? ` · ${r.city}` : ""}
                                            </div>
                                        </div>
                                        <div style="font-size: 11.5px; color: var(--gray-400); white-space: nowrap;">
                                            ${dateStr}
                                        </div>
                                    </div>
                                    <div class="review-item-stars" style="color: #f59e0b; font-size: 14px; margin: 10px 0 6px 0;">
                                        ${stars}
                                    </div>
                                    ${r.title ? `<h4 style="font-size: 14px; font-weight: 700; color: var(--gray-900); margin: 0 0 6px 0;">${r.title}</h4>` : ""}
                                    <p style="font-size: 13.5px; color: var(--gray-700); line-height: 1.55; margin: 0;">${r.content}</p>
                                </div>
                            `;
                        }).join("");
                    }
                }
            } catch (e) {
                console.error("Error loading reviews:", e);
            }
        };
        loadReviews();

        // Modal triggers
        const revModal = document.getElementById("customerReviewModal");
        const openRevBtn = document.getElementById("openReviewModalBtn");
        const emptyRevBtn = document.getElementById("emptyWriteReviewBtn");
        const closeRevBtn = document.getElementById("closeCustRevModal");
        const cancelRevBtn = document.getElementById("cancelCustRevBtn");

        const openModal = () => revModal && revModal.classList.add("open");
        const closeModal = () => revModal && revModal.classList.remove("open");

        if (openRevBtn) openRevBtn.onclick = openModal;
        if (emptyRevBtn) emptyRevBtn.onclick = openModal;
        if (closeRevBtn) closeRevBtn.onclick = closeModal;
        if (cancelRevBtn) cancelRevBtn.onclick = closeModal;
        if (revModal) revModal.onclick = (e) => { if (e.target === revModal) closeModal(); };

        // Star picker in modal
        const starSpans = document.querySelectorAll("#sr-star-picker span");
        const ratingInput = document.getElementById("sr-rating");
        starSpans.forEach((span) => {
            span.onclick = () => {
                const val = Number(span.getAttribute("data-star"));
                if (ratingInput) ratingInput.value = val;
                starSpans.forEach((s) => {
                    const sVal = Number(s.getAttribute("data-star"));
                    s.textContent = sVal <= val ? "★" : "☆";
                });
            };
        });

        // Submit Review Form
        const revForm = document.getElementById("storefrontReviewForm");
        if (revForm) {
            revForm.onsubmit = async (e) => {
                e.preventDefault();
                const submitBtn = document.getElementById("submitCustRevBtn");
                submitBtn.disabled = true;
                submitBtn.textContent = "Envoi en cours...";

                const payload = {
                    productId: p.id,
                    productTitle: p.title,
                    productImage: p.featuredImage,
                    author: document.getElementById("sr-author").value.trim(),
                    city: document.getElementById("sr-city").value.trim(),
                    country: document.getElementById("sr-country").value,
                    rating: Number(document.getElementById("sr-rating").value) || 5,
                    title: document.getElementById("sr-title").value.trim(),
                    content: document.getElementById("sr-content").value.trim(),
                    verified: true,
                    status: "PUBLISHED"
                };

                try {
                    const r = await fetch("/api/reviews", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify(payload)
                    });
                    if (r.ok) {
                        alert("Merci pour votre avis ! Il a été publié avec succès.");
                        closeModal();
                        loadReviews();
                    } else {
                        alert("Erreur lors de l’envoi. Veuillez réessayer.");
                        submitBtn.disabled = false;
                        submitBtn.textContent = "Publier mon avis";
                    }
                } catch (err) {
                    alert("Erreur de connexion.");
                    submitBtn.disabled = false;
                    submitBtn.textContent = "Publier mon avis";
                }
            };
        }
    });
</script>
